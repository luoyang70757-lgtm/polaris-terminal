{
  "name": "polaris-terminal",
  "version": "1.0.1",
  "description": "Polaris(北极星)· 科幻风 SSH/SFTP 终端工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "mock": "node mock/mock-server.js",
    "dev": "electron . --dev",
    "clean": "node clean-release.js",
    "dist": "npm run clean && electron-builder"
  },
  "author": "jms",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "ssh2": "^1.17.0",
    "xlsx": "^0.18.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0"
  },
  "build": {
    "appId": "com.polaris.terminal",
    "productName": "Polaris",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "src/**",
      "mock/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableName": "polaris"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
